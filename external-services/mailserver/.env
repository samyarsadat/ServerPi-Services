# GENERAL
TZ=Europe/Istanbul
DOCKER_MY_NETWORK=caddy_net
MY_DOMAIN=ssa-selfhosted.com
MAIL_HOST=mail.${MY_DOMAIN}

# CERTBOT
CERT_DOMAIN=${MAIL_HOST}
CERTBOT_EMAIL=samyarsadat@gigawhat.net

# DOCKER-MAILSERVER - General
OVERRIDE_HOSTNAME=${MAIL_HOST}
POSTMASTER_ADDRESS=postmaster@gigawhat.net
LOG_LEVEL=info
POSTFIX_INET_PROTOCOLS=ipv4
ENABLE_UPDATE_CHECK=1

# DOCKER-MAILSERVER - TLS
SSL_TYPE=letsencrypt
TLS_LEVEL=intermediate

# DOCKER-MAILSERVER - Outbound relay
RELAY_HOST=smtp-relay.gmail.com
RELAY_PORT=587

# DOCKER-MAILSERVER - Anti-spam / Anti-virus
ENABLE_RSPAMD=1
RSPAMD_GREYLISTING=0
ENABLE_CLAMAV=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_POSTGREY=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
MOVE_SPAM_TO_JUNK=1

# DOCKER-MAILSERVER - Security
ENABLE_FAIL2BAN=1
POSTSCREEN_ACTION=enforce
SPOOF_PROTECTION=1
ENABLE_MANAGESIEVE=1
