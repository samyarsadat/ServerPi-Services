# GENERAL
TZ=Europe/Istanbul
DOCKER_MY_NETWORK=caddy-net
MY_DOMAIN=ssa-selfhosted.com
SVPI2_IP_ADDR=192.168.1.115

# GRAFANA
GF_SECURITY_ADMIN_USER=admin
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROOT_URL=https://grafana.${MY_DOMAIN}
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_COOKIE_SAMESITE=strict
GF_SECURITY_DISABLE_GRAVATAR=true
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=true

# PROMETHEUS
PROMETHEUS_RETENTION_SIZE=10GB

# GRAFANA EMAIL
GF_SMTP_ENABLED=true
GF_SMTP_HOST=in-v3.mailjet.com:587
GF_SMTP_FROM_ADDRESS=grafana@${MY_DOMAIN}