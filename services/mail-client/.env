# GENERAL
TZ=Europe/Istanbul
DOCKER_MY_NETWORK=caddy_net
MY_DOMAIN=ssa-selfhosted.com
MAIL_HOST=mail.${MY_DOMAIN}
SVPI2_IP_ADDR=192.168.1.115

# ROUNDCUBE
ROUNDCUBEMAIL_DB_TYPE=sqlite
ROUNDCUBEMAIL_DEFAULT_HOST=ssl://${MAIL_HOST}
ROUNDCUBEMAIL_DEFAULT_PORT=993
ROUNDCUBEMAIL_SMTP_SERVER=tls://${MAIL_HOST}
ROUNDCUBEMAIL_SMTP_PORT=587
ROUNDCUBEMAIL_DEFAULT_CHARSET=UTF-8
ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=25M
ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,managesieve,newmail_notifier
